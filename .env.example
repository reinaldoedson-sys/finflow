# VITE_QUOTES_API_URL: URL base para a API de cotações de mercado (opcional).
# Se não estiver definida, o cliente utiliza por padrão o endpoint local '/api/quotes'.
# Exemplo em produção: VITE_QUOTES_API_URL="https://meu-dominio.com/api/quotes"
VITE_QUOTES_API_URL="/api/quotes"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
